PORT=5000
MONGODB_URI=mongodb+srv://your-username:your-password@cluster.mongodb.net/executive-productivity
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d
NODE_ENV=development
CLIENT_URL=http://localhost:5173
CODEO_USE_LLM=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5

# Meeting reminders (comma-separated minutes before start)
REMINDER_OFFSETS_MINUTES=15,60

# Emergency token reset (cron — default: 1st of month at midnight)
EMERGENCY_TOKEN_RESET_CRON=0 0 1 * *
EMERGENCY_TOKEN_DEFAULT=3

# Optional email for meeting reminders
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_SECURE=false
